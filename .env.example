# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is in .gitignore - never commit real tokens or passwords.

# ---------- Data source ----------
# api  = download from the API only (fails if the API is down)
# file = use LOCAL_DATA_FILE only
# auto = try the API first, use LOCAL_DATA_FILE if the API is not available
SOURCE_MODE=auto
SOURCE_URL=http://65.52.154.25
SOURCE_TOKEN=
LOCAL_DATA_FILE=data/sample/transactions_snapshot.json

HTTP_TIMEOUT=30
HTTP_RETRIES=3
HTTP_BACKOFF_SECONDS=2
MAX_DOWNLOAD_MB=200

# ---------- SQL Server ----------
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=bank
# true  = Windows authentication (no user/password needed)
# false = SQL Server authentication with DB_USER / DB_PASSWORD
DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
# true is fine for a local server with a self-signed certificate
DB_TRUST_SERVER_CERTIFICATE=true

# ---------- Processing ----------
# rows read from the CSV at once / rows sent to SQL Server per INSERT batch
CHUNK_SIZE=5000
BATCH_SIZE=1000
# stop the run (before loading core tables) if more than this share of rows is invalid
MAX_REJECT_RATIO=0.10

# ---------- Logs and files ----------
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data
# how many old raw/processed files to keep
KEEP_RUNS=7
